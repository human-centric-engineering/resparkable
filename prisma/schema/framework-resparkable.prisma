  /// acting, never as an unattributed line that reads like somebody hiding.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️  Hand-written FK, ON DELETE SetNull,
  /// probe B11. There is deliberately NO index on this column: §23.10 forbids
  /// any aggregate over members, and the absent index is what makes the
  /// leaderboard awkward as well as forbidden.
  createdByUserId String?

  /// captured | completed | promoted | archived | restored | snoozed |
  /// unsnoozed | linked | shared | revoked
  kind String @db.VarChar(24)

  entityType String @db.VarChar(16)
  entityId   String

  metadata Json?

  /// user | system — who wrote this, and the only thing the demand gate reads.
  ///
  /// `system` means the row was written from inside a workflow execution: a
  /// background run's own output, not something the owner did. The distinction
  /// is load-bearing rather than descriptive. Without it every background run
  /// writes the evidence that authorises the next one — all four workflows
  /// finish by recording a `review` event, and triage also records the
  /// promotions and tasks it creates — so the gate can never answer "nothing
  /// changed" and an idle brain is billed nightly, silently, for ever.
  ///
  /// Set at one chokepoint (`ResparkableCapability.execute`, from
  /// `CapabilityContext.workflowExecutionId`) rather than by each writer, so a
  /// background writer added later is marked without anyone remembering to.
  /// A denylist over `kind`/`entityType` was the alternative and cannot work:
  /// "retention archived this" and "the owner archived this" are the same row.
  source String @default("user") @db.VarChar(8)

  createdAt DateTime @default(now())

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/resparkable-isolation.ts.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  @@index([spaceId, kind, createdAt(sort: Desc)])
  @@index([spaceId, createdAt(sort: Desc)])
  @@index([spaceId, entityType, entityId])
  /// The demand gate. `source` sits BETWEEN the two columns of the index above,
  /// and a b-tree cannot skip a middle column — so that index cannot serve this
  /// query however similar it looks. On a dormant brain every event since the
  /// last run is system-authored, so without this the `EXISTS` walks all of
  /// them to answer "no": the one answer that saves money would be the most
  /// expensive to reach.
  @@index([spaceId, source, createdAt(sort: Desc)])
  @@map("framework_resparkable_event")
}

/// Instance settings — the deliberate exception to rule 2 at the top of this file.
///
/// **This is the one Resparkable table with no `userId`**, so it is also the one
/// table outside the D1 cascade. That is not an oversight: what it holds are
/// deployment facts, not user data. "Does this deployment's storage provider
/// hold private objects safely?" has one answer per install, and it belongs to
/// whoever operates the install — so it is an admin-area setting, and erasing a
/// user must not change it.
///
/// Singleton by `slug`, mirroring `AiOrchestrationSettings` — a `@unique`
/// defaulted column rather than a magic primary key, so the upsert has a natural
/// target and a second row is a constraint violation rather than a silent
/// second source of truth.
model ResparkableSettings {
  id   String @id @default(cuid())
  slug String @unique @default("global")

  /// discard | retain — what happens to an uploaded document's original bytes.
  ///
  /// `discard` (default) parses the file, keeps `extractedText` and the embedding
  /// chunks, and drops the buffer: no blob, no download surface, nothing to leak.
  /// `retain` uploads under `framework-resparkable/<userId>/<fileHash>` with
  /// `public: false` and serves downloads through a short-lived signed URL, which
  /// only works on a provider that implements `getSignedUrl` and stores objects
  /// privately. The admin page names the resolved provider and says so, because
  /// choosing `retain` on the local provider means writing user documents into a
  /// statically-served directory.
  documentOriginals String @default("discard") @db.VarChar(16)

  /// Upload ceiling in bytes. Null falls back to the code default.
  ///
  /// A setting rather than a constant because Resparkable ships two contradictory
  /// caps — 5 MB global (`lib/validations/storage.ts`) and 50 MB local to the
  /// bulk knowledge route — and Resparkable has to pick one without pretending the
  /// other doesn't exist (Resparkable ask #9).
  maxDocumentBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("framework_resparkable_settings")
}

/// Phase 29: billing foundation. One credit account per space, created
/// lazily (not inline with `ensureResparkableSpace`) the first time a
/// billing-aware code path touches it, see `services/billing.ts`.
model ResparkableCreditAccount {
  id      String @id @default(cuid())
  spaceId String @unique

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?
  balanceCredits  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/resparkable-isolation.ts.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  @@map("framework_resparkable_credit_account")
}

/// Append-only spend/grant history behind `ResparkableCreditAccount.balanceCredits`.
model ResparkableCreditLedgerEntry {
  id      String @id @default(cuid())
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  /// admin_grant | agent_spend | refund
  kind         String @db.VarChar(16)
  creditsDelta Float

  tokenCostUsd     Float?
  serviceChargeUsd Float?
  totalUsd         Float?

  /// Soft references, no FK — tier-boundary pattern (transfer.md), consistent
  /// with every other cross-table reference this tier uses.
  relatedConversationId      String?
  relatedWorkflowExecutionId String?
  relatedCostLogId           String?

  note             String?  @db.VarChar(500)
  createdByAdminId String? // admin_grant only
  createdAt        DateTime @default(now())

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/resparkable-isolation.ts.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  /// Idempotency guard for the Site B tick-poll (jobs.ts): a repeat pass over
  /// an already-billed execution hits this constraint instead of double-charging.
  /// Nullable, so admin_grant/refund/chat/ideate rows (no execution id) are
  /// unconstrained. Postgres treats each NULL as distinct.
  @@unique([kind, relatedWorkflowExecutionId])
  @@index([spaceId, createdAt])
  @@map("framework_resparkable_credit_ledger_entry")
