/// Global billing configuration — the same operator-singleton exception
/// `ResparkableSettings` documents above (no `userId`, not in the D1 cascade).
model ResparkableBillingSettings {
  id                        String   @id @default(cuid())
  slug                      String   @unique @default("global")
  creditsPerUsd             Float    @default(1)
  serviceChargePercent      Float    @default(0)
  costVisibleToUsersDefault Boolean  @default(true)
  currencyLabel             String   @default("credits") @db.VarChar(32)
  newUserGrantCredits       Float    @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("framework_resparkable_billing_settings")
}

/// The one queue. Every piece of per-user background work is a row here.
///
/// **One row per owner per kind, not one per occurrence.** `dueAt` moves
/// forward on completion, so the table is bounded at (brains × kinds) and a
/// backlog makes rows LATE, never numerous. At 100k users × 7 kinds that is
/// 700k rows, which is small, indexed, and does not grow when the workers fall
/// behind. That invariant is the one that distinguishes this design from what
/// it replaces: a fixed-batch drain under backlog grows a queue, this one grows
/// a *latency*. The first is invisible until it is fatal, the second shows up
/// on a graph.
///
/// Contrast `AiWorkflowSchedule`, which this replaces for Resparkable's own
/// work. That table stores a cron string per row and therefore needs a
/// correction pass after every DST change — Resparkable paid for one, plus the
/// row-per-user-per-workflow creation and deletion around it. `dueAt` is
/// recomputed from the owner's timezone every time the work completes, so it is
/// always calculated against the offset in force, and there is nothing to
/// correct. Deleting that correction pass is the whole reason this column is a
/// timestamp rather than an expression.
///
/// See `.context/framework/resparkable/phase-56-plan.md`.
model ResparkableJob {
  id String @id @default(cuid())

  /// **Keyed on the OWNER, not the space.** Today those are the same thing, so
  /// this costs nothing. Under `plan.md` §24 (Workspaces) they diverge, and W2
  /// requires the row count to stay invariant as a person acquires workspaces:
  /// one `triage` job per person whose run fans out over their live spaces, not
  /// one per space. Keying on the space would put the largest queue in the
  /// system on the wrong side of that requirement and force a second migration.
  ///
  /// Renamed by §23's phase 45 with the other satellites: it relates to the
  /// space today because a space is an owner; afterwards it relates to
  /// `ownerUserId`.
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  /// triage | briefing | weekly_review | horizon_check | sweep | retention | reindex
  ///
  /// The vocabulary lives in `lib/framework/resparkable/queue/kinds.ts`, which
  /// also carries each kind's cadence and whether it is demand-gated. A string
  /// rather than an enum for the reason every other `kind` column in this
  /// schema is one: adding a kind should be a code change and a backfill, not a
  /// type migration that has to be deployed before the code that uses it.
  kind String @db.VarChar(24)

  /// The next moment this work is due. The queue is `dueAt <= now()`.
  dueAt DateTime

  /// Lease, not a boolean flag. A worker that dies mid-job must not pin the row
  /// for ever, so reclaim is `leaseExpiresAt < now()` rather than a separate
  /// reaper deciding what "stuck" means. `leasedBy` is checked on settle, so a
  /// worker whose lease expired mid-run cannot clobber the row that has since
  /// been re-claimed by someone else.
  leasedBy       String?   @db.VarChar(64)
  leaseExpiresAt DateTime?

  /// Consecutive failures. Feeds exponential backoff on `dueAt` and, past the
  /// cap, marks the row dormant rather than retrying for ever at cost. Reset to
  /// zero by any successful run.
  attempts  Int       @default(0)
  lastRunAt DateTime?
  lastError String?   @db.Text

  /// Demand gating (`scale.md` S7 / `plan.md` §24 W3). Set when a run was
  /// skipped because nothing had changed in this brain since `lastRunAt`;
  /// cleared by the next write. A dormant row is still claimed, just far less
  /// often — never deleted, because a deleted row is one that never comes back
  /// when the person returns.
  ///
  /// It doubles as the backoff clock: the wait is however long the row has
  /// already been dormant, floored at the kind's normal cadence and capped at a
  /// week. So a brain quiet for three hours is re-checked in three hours and
  /// one quiet for a month is re-checked weekly, with no counter column.
  dormantSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which removes
  /// every row here. Verified by scripts/framework/resparkable/smoke-isolation.ts.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  /// Idempotent enqueue: "make sure this owner has a triage job" is an
  /// `ON CONFLICT DO NOTHING`. Owner-keyed, so it stays one row per kind
  /// however many workspaces they hold (§24 W2).
  @@unique([spaceId, kind])
  /// The claim query, and the only index it needs. Ordinary and composite
  /// rather than partial: the claim's predicate is `now()`-relative, so there
  /// is no time-independent subset to index on, and an ordinary index is one
  /// Prisma can model — which means `prisma migrate dev` recreates it rather
  /// than silently dropping it, and it needs no drift probe.
  @@index([dueAt, leaseExpiresAt])
  @@map("framework_resparkable_job")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sharing (Release 2, §13). Two orthogonal facts, deliberately not merged:
//
//   • `visibility` on the entity — ONLY about the public-link surface, so the
//     hot path never joins to find out whether a row is shared.
//   • named grants — entirely in `ResparkableGrant` rows, never denormalised
//     onto the entity or its children.
//
// Shareable: area, goal, project, review, board, task. NOT thought. The raw
// capture inbox is the likeliest place for something you would be mortified to
// leak, and making it unshareable is a feature, not a gap — promote a thought
// to a task first, which is the workflow anyway.
// ─────────────────────────────────────────────────────────────────────────────

/// A named grant: one person, one item, read-only or read-and-comment.
///
/// **`userId` is the OWNER, not the grantee.** That preserves D1 — the row
/// cascades from `ResparkableSpace` like every other table here — and it keeps
/// `WHERE userId = $1` meaning the same thing in this table as in all the
/// others. The grantee is `granteeUserId` / `granteeEmail`, and reading this
/// table by grantee is the one thing `repo/**` must never do: that is a shared
/// query, and it lives in `lib/framework/resparkable/access/*` (D5).
///
/// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
/// `framework_resparkable_grant_granteeUserId_fkey` (→ `"user"("id") ON DELETE
/// CASCADE`) is hand-written in the migration, for the same reason
/// `ResparkableSpace`'s is: `User` lives in a Sunrise-owned file and this tier
/// must not add a relation field there. **That FK is Art. 17 for the grantee.**
/// Nothing cascades to this row when the grantee is erased — `userId` is the
/// owner — and `SetNull` would leave a live grant addressed by `granteeEmail`:
/// retained personal data belonging to an erased person, on a row they cannot
/// reach. Probe B8 asserts the constraint and its ON DELETE action.
///
/// The unaccepted case (`granteeUserId IS NULL`) has no FK to hang off, so it
/// is covered by an erasure `scrubInTransaction` hook matching `granteeEmail`
/// instead. Both halves are needed; neither covers the other.
model ResparkableGrant {
  id      String @id @default(cuid())
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  /// area | goal | project | review | board | task. Never `thought`.
  entityType String @db.VarChar(16)
  entityId   String

  /// Null until the invite is accepted. Hand-written FK — see the block above.
  granteeUserId String?
  /// Lower-cased at the boundary. The address the grant was issued to, which is
  /// what makes an unaccepted invite addressable and revocable.
  granteeEmail  String

  /// viewer | commenter. `commenter` is what makes `ResparkableComment` mean
  /// something; it never implies any write access to the item itself.
  role String @default("viewer") @db.VarChar(16)

  /// Include the shared item's own `notes` (and its cascaded tasks'). Default
  /// off: a shared task exposes title, status and due date, and nothing else
  /// (§13). Per-grant rather than per-item, because "show Bob the detail" and
  /// "show the whole internet the detail" are different decisions.
  includeTaskDetail Boolean @default(false)

  /// sha256 of the invite token. The token grants nothing on its own — it only
  /// binds an account to a grant that already exists — so a leaked invite email
  /// is useless without that mailbox. Null once accepted, or for a grant issued
  /// to an address that already has an account.
  inviteTokenHash String?   @unique
  inviteSentAt    DateTime?
  acceptedAt      DateTime?

  /// Defaults to 30 days at the boundary, max 365. `null` requires an explicit
  /// "never expires" choice — see `isShareActive` (`lib/utils/share-window.ts`).
  expiresAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path for the OWNER. See the drift warning above for the
  /// grantee's, which is a different FK to a different table.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  /// One grant per address per item. Re-granting is an update, not a second row
  /// — two live grants with different roles would make "what can Bob do" a
  /// question with two answers.
  @@unique([entityType, entityId, granteeEmail])
  /// The access layer's read: "which of this viewer's grants are live?"
  @@index([granteeUserId, revokedAt])
  @@index([granteeEmail, revokedAt])
  /// The owner's read: "who can see this item?"
  @@index([spaceId, entityType, entityId])
  @@map("framework_resparkable_grant")
}

/// A public read-only link: a bearer credential to one item.
///
/// **The token is hashed, deviating from codebase precedent on purpose.**
/// `AiAgentEmbedToken` and `AiAgentInviteToken` store plaintext cuids, which is
/// fine for admin-issued, deployment-scoped tokens. A brain share link is a
/// bearer credential to a private person's life: a database dump or a log leak
/// must not hand over every user's notes. Mint with
/// `randomBytes(24).toString('base64url')` — 192 bits, and deliberately **not**
/// a cuid, which is timestamp-prefixed and monotonic, precisely the wrong shape
/// for "unguessable".
model ResparkableShareLink {
  id      String @id @default(cuid())
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  /// area | goal | project | review | board | task. Never `thought`.
  entityType String @db.VarChar(16)
  entityId   String

  /// sha256 hex of the token. The only copy that exists after minting.
  tokenHash   String @unique
  /// First few characters of the token, so the owner can tell two links apart
  /// in the UI. Short enough to be useless on its own.
  tokenPrefix String @db.VarChar(12)

  /// Include the one-level typed cascade (project → its tasks, goal → its child
  /// goals, board → its cards' tasks). Off means the link shows exactly one item.
  includeChildren   Boolean @default(false)
  /// As `ResparkableGrant.includeTaskDetail`, and the same default. A public
  /// link is a document handed to strangers; the bar for `notes` is higher here
  /// than for a named grant, not lower.
  includeTaskDetail Boolean @default(false)

  /// 30 days by default, 365 max. `null` requires an explicit "never expires".
  expiresAt DateTime?
  revokedAt DateTime?

  /// Enough to answer "is anyone actually opening this?" without keeping a log
  /// of who: no IP, no user agent, no per-view row. A reader of a public link is
  /// a person with no account here, and the least that answers the owner's
  /// question is the right amount to keep.
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing the owner takes the link with it, which is
  /// what makes "erase me" also mean "my links stop working".
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  @@index([spaceId, entityType, entityId])
  @@map("framework_resparkable_share_link")
}

/// A comment left on a shared item — what makes `role: 'commenter'` mean
/// something.
///
/// ## `userId` is the OWNER, and the author is a second, hand-written FK
///
/// The same shape as `ResparkableGrant`, for the same reason: the row belongs
/// to the brain it was written into, so it cascades from `ResparkableSpace`
/// like every other table in this tier and `WHERE userId = $1` keeps meaning
/// the same thing. The *author* is somebody else, and needs its own path out.
///
/// ⚠️ **PRISMA-SCHEMA DRIFT WARNING.** `framework_resparkable_comment_authorUserId_fkey`
/// (→ `"user"("id") ON DELETE CASCADE`) is hand-written in
/// `20260828120000_resparkable_comments/migration.sql`, because `User` lives in
/// a Sunrise-owned schema file and a relation declared here would rewrite it.
/// A regenerated migration will not re-emit it. **Probe B9 asserts it**, and
/// `npm run db:drift-check` is not optional after `migrate dev`.
///
/// **CASCADE, never SetNull-and-keep.** The body is free text an erased person
/// wrote — often about themselves, sometimes about somebody else — and keeping
/// it under a nulled author is retained personal data on a row its writer can
/// no longer reach. §13 is explicit about this one.
///
/// ## What this table must never touch
///
/// **A grantee's comment is third-party text arriving inside the owner's data,
/// so it is a prompt-injection vector aimed at the owner's own agent.** It is
/// therefore excluded from `ResparkableEmbedding`, from the context builder and
/// from every background workflow — structurally, by nothing in
/// `embedding/**` or `context/**` ever reading this table. There is no flag to
/// get wrong.
///
/// ## Why there is no `parentCommentId`
///
/// Threading is a product decision nobody has made, and a nullable self-FK
/// added "in case" is the kind of column that acquires meaning by accident.
/// A flat list per item is what a commenter grant promises: a way to say
/// something back, not a discussion forum.
model ResparkableComment {
  id      String @id @default(cuid())
  /// The OWNER of the item, not the author. See the header.
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  /// area | goal | project | review | board | task. Never `thought` — the raw
  /// capture inbox is unshareable, so nothing can be commented on there.
  entityType String @db.VarChar(16)
  entityId   String

  /// Who wrote it. Hand-written FK — see the drift warning above. Never null:
  /// a comment with no author is a comment nobody can be accountable for, and
  /// erasure deletes the row rather than orphaning it.
  authorUserId String

  /// Plain text, not markdown, and deliberately so. Rendering a grantee's
  /// markdown on the owner's screen widens the surface for no benefit the
  /// feature needs — a comment is a sentence, not a document.
  body String @db.Text

  /// Set when the author edits. `null` means it says what it said.
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// D1: the cascade path for the OWNER. See the drift warning above for the
  /// author's, which is a different FK to a different table.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  /// The read every comment surface makes: "what has been said on this item?",
  /// oldest first.
  @@index([spaceId, entityType, entityId, createdAt])
  /// The erasure read, and the author's own "what have I written?" export.
  @@index([authorUserId])
  @@map("framework_resparkable_comment")
}
