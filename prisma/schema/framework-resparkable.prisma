// ─────────────────────────────────────────────────────────────────────────────
// Resparkable — framework-tier schema
//
// `prisma.config.ts` points Prisma at the `prisma/schema` folder, so every
// `*.prisma` file in it is part of one schema. `framework-*.prisma` is the
// filename glob Resparkable reserves for a framework tier: Resparkable core never
// creates a file matching it, so this file merges cleanly on upgrade.
//
// THE THREE RULES (see .context/framework/resparkable/plan.md §1 and D1):
//
//   1. Every table is `@@map("framework_resparkable_<name>")`. The prefix is what
//      keeps Resparkable's tables from colliding with a host project's own.
//   2. Every model carries `spaceId`, and every index leads with it. There is
//      exactly ONE satellite table, `ResparkableSpace`, and its `ownerUserId`
//      holds the hand-written FK to `"user"("id") ON DELETE CASCADE. Everything
//      else cascades from that, so GDPR erasure is transitive and no column is
//      ever added to `User`. A GROUP space has `ownerUserId` NULL and is
//      therefore, correctly, not reachable by that cascade at all (§23.2): one
//      member closing their account must not take a shared workspace with them.
//      Until phase 46 nothing creates one.
//   3. Cross-space reads are structurally impossible in `repo/*` (D5). The
//      schema's job is to make `WHERE spaceId = $1` the natural query.
//
// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️  (see also the per-model blocks below)
// A set of Postgres objects here is managed via raw SQL in the migration because
// Prisma cannot model them, and `npx prisma migrate dev` WILL emit DROP
// statements for every one of them on every schema-diff run. Always inspect
// generated migration SQL and remove any line touching them before applying:
// every one of them fails **silently, with no error**.
//
// The count is deliberately not restated here. It said "six" from the table's
// first day until phase 45, while `db-drift.ts` had grown to nine, and a number
// that drifts is worse than no number because it reads as a checklist somebody
// has completed. `lib/framework/resparkable/db-drift.ts` IS the inventory:
// B1 (the GDPR-cascade FK, on `ownerUserId` since phase 45), B1b and B3 and B7
// (objects that must NOT exist), B2 (the halfvec column), B4/B6 (GENERATED
// tsvector columns), B5 (the GIN index over B4), B8/B9 (grantee and comment
// author cascades), B10 (the one-default-per-owner partial unique) and B11
// (23 `createdByUserId` keys in one probe).
//
// Two of them guard live code rather than a future restructuring, and are worth
// naming: B4/B6, the GENERATED tsvector columns, are never populated if
// recreated as plain columns, so keyword search silently returns nothing for
// every row written afterwards while old rows still match. The HNSW index is NOT
// on today's query path (the hybrid search's pre-filter and blended ORDER BY
// defeat it, verified with EXPLAIN), so B3 guards a future restructuring.
//
// Run `npm run db:drift-check` after EVERY `migrate dev`. Non-negotiable.
// ─────────────────────────────────────────────────────────────────────────────

// The model graph account transfer runs on, rebuilt on every `prisma generate`.
//
// It describes the WHOLE schema, not just this tier — a foreign key does not
// stop at a tier boundary (`ResparkableReview.workflowExecutionId` already
// points into the orchestration tables), so a graph that did would order
// imports wrongly.
//
// It is declared HERE, in a framework-tier file, only because Resparkable must
// not edit Sunrise-owned files and `base.prisma` is one. Upstream is the right
// home for it — filed as ask #37 in
// `.context/framework/resparkable/sunrise-asks.md`. If Sunrise adopts it,
// DELETE this block in the same change: two generators sharing a name is a
// hard `prisma generate` error.
generator portability {
  provider = "node ./prisma/generators/portability.mjs"
  output   = "../../lib/portability/model-graph.generated.ts"
}

/// One row per user — the satellite table everything else hangs off (D1).
///
/// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
/// `framework_resparkable_space_userId_fkey` (→ `"user"("id") ON DELETE CASCADE`)
/// is hand-written in the migration. Prisma cannot model it because `User`
/// lives in a Sunrise-owned schema file and Resparkable must not add a relation
/// field there (CLAUDE.md: never add columns to `User`). **That FK is the GDPR
/// cascade** — probe B1 asserts both its existence and its ON DELETE action.
model ResparkableSpace {
  id      String @id @default(cuid())
  spaceId String @unique

  /// personal | group. A personal space has `ownerUserId` set and is reached by
  /// the D1 cascade; a group space has it NULL and points at a `ResparkableGroup`
  /// instead (§23.2), which is exactly why erasing a member cannot take a shared
  /// workspace with them. Probe B1 asserts both halves.
  kind String @default("personal") @db.VarChar(16)

  /// The human owner, and the anchor of the GDPR cascade.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// `framework_resparkable_space_ownerUserId_fkey` (→ `"user"("id")`
  /// ON DELETE CASCADE) is hand-written in the migration, for the same reason
  /// the old `userId` FK was: `User` lives in a Sunrise-owned schema file and
  /// Resparkable must not add a relation field there. Probe B1 asserts its
  /// existence AND its ON DELETE action on THIS column.
  ///
  /// **Deliberately NOT `@unique`.** That absence is the feature, not an
  /// oversight: it is the whole schema-level cost of several workspaces per
  /// owner (§24.1). Do not add the constraint as a tidy-up reasoning that one
  /// person obviously has one brain.
  ownerUserId String?

  /// Where unnamed capture lands and what the app opens on (§24.2). A real
  /// setting rather than a fallback: a user may change it and may not have none,
  /// which the partial unique index (probe B10) enforces at the database rather
  /// than only in the service.
  isDefault Boolean @default(false)

  /// Display name and URL segment. Null on the space every account already had,
  /// because naming a thing you have only one of is a question nobody asked;
  /// Release 10 fills them in when it lets you create a second.
  name String? @db.VarChar(120)
  slug String? @db.VarChar(64)

  /// Archiving a workspace hides it without destroying it (§24.1). Archiving the
  /// default promotes a successor and says so out loud.
  archivedAt DateTime?

  /// Routing token for email capture: brain+<inboxToken>@<RESPARKABLE_INBOX_DOMAIN>.
  inboxToken String @unique

  /// IANA zone. Snooze presets and retention windows resolve HERE, never in
  /// server time — an item that unsnoozes at 2am because the server is UTC is
  /// the kind of small wrongness that makes a tool feel careless (§10).
  timezone String @default("UTC") @db.VarChar(64)

  /// Time-of-day energy profile, Zod-validated at the boundary.
  energyProfile Json?

  /// Scorer weights (§10). Zod-validated; defaults live in code, not the DB, so
  /// a new factor doesn't need a backfill.
  priorityWeights Json?

  /// Retention windows (§11). Columns from day one so they never need
  /// backfilling against live data.
  retentionPolicy Json?

  /// structured | balanced | exploratory — governs what the morning briefing
  /// SELECTS, not just how it is worded (§6). Never an input to score.ts.
  workStyle String @default("balanced") @db.VarChar(16)

  /// Cosine-similarity floor for proposing a connection. `null` uses the
  /// measured default (0.55).
  ///
  /// Per-user because the right value is **model-dependent**, which the phase-4
  /// work discovered the hard way: the plan specified 0.72, and against
  /// `text-embedding-3-small` that sits above the signal — the flagship
  /// "same idea, different words" pair scores 0.679, so the engine proposed
  /// nothing at all, silently and for ever. Anyone running a different embedding
  /// model needs a different number, and hard-coding one makes the failure
  /// invisible rather than adjustable.
  connectionStrengthFloor Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back-relations for the D1 cascade. Every scoped table hangs off this row,
  // so `DELETE FROM "user"` removes the space and the space removes the brain.
  areas          ResparkableArea[]
  goals          ResparkableGoal[]
  projects       ResparkableProject[]
  tasks          ResparkableTask[]
  thoughts       ResparkableThought[]
  links          ResparkableLink[]
  embeddings     ResparkableEmbedding[]
  boards         ResparkableBoard[]
  boardCards     ResparkableBoardCard[]
  tags           ResparkableTag[]
  taskTags       ResparkableTaskTag[]
  checklistItems ResparkableChecklistItem[]
  entities       ResparkableEntity[]
  documents      ResparkableDocument[]
  timeBlocks     ResparkableTimeBlock[]
  reviews        ResparkableReview[]
  events         ResparkableEvent[]

  /// Phase 29: billing. `creditAccount` is optional at the type level only
  /// because Prisma requires it (the row is created lazily, not inline with
  /// the space); every space is expected to gain one the first time billing
  /// code touches it. See `ResparkableCreditAccount`.
  creditAccount       ResparkableCreditAccount?
  creditLedgerEntries ResparkableCreditLedgerEntry[]

  /// Release 2: sharing. Both hang off the OWNER, never the grantee — see
  /// `ResparkableGrant`'s header for why that is what preserves D1.
  grants     ResparkableGrant[]
  shareLinks ResparkableShareLink[]
  comments   ResparkableComment[]

  /// Phase 56: the job queue. One row per kind per owner; see `ResparkableJob`.
  ///
  /// `lastSweptAt` and its index used to sit here — the across-users rotation
  /// cursor the connection sweep paged through. It is gone, because the queue
  /// replaces it: a `dueAt` per kind says when each piece of work is next
  /// owed, which is a strictly better answer than "who was worked on longest
  /// ago" and does not force every kind onto one shared rotation. Keeping both
  /// would have left two answers to "when was this brain last worked on".
  jobs ResparkableJob[]

  @@index([ownerUserId])
  @@map("framework_resparkable_space")
}

/// Life domains (Health, Career…): the standing parts of a person's life, kept
/// deliberately free of any hour target or quota. Resparkable is a reflection
/// and understanding tool, not an optimisation tool: no scorer factor weighs an
/// Area by time logged against it (see `.context/framework/resparkable/design-principles.md`).
model ResparkableArea {
  id      String @id @default(cuid())
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  name        String
  slug        String
  description String? @db.Text
  colour      String? @db.VarChar(16)
  sortOrder   Int     @default(0)

  /// private | link. NEVER a filter on the owner's own read path (D5, §13).
  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  /// Bumped in the same UPDATE as every write. Dormant until Release 3 — its
  /// absence would later force a full-table backfill against live data (§15).
  rev Int @default(0)

  /// Null = needs (re)embedding. Archiving nulls it and drops the embedding
  /// rows outright; restoring re-enqueues (§11).
  indexedHash String?

  goals      ResparkableGoal[]
  projects   ResparkableProject[]
  timeBlocks ResparkableTimeBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/resparkable-isolation.ts.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  @@unique([spaceId, slug])
  @@index([spaceId, archivedAt])
  @@index([spaceId, visibility])
  @@map("framework_resparkable_area")
}

/// Horizons: life → year → quarter → month → week.
model ResparkableGoal {
  id      String @id @default(cuid())
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  title       String
  /// Unique per user, as for areas, projects and entities. A goal is an
  /// addressable thing — the vault has always filed it at
  /// `Goals/<horizon>/<slug>.md` — and until this column existed that address
  /// was recomputed from the title on every write, so nothing could recognise
  /// a goal it had already seen. Both importers now match on it.
  slug        String
  description String? @db.Text

  /// life | year | quarter | month | week. Nearest horizon reached by the
  /// goal-alignment walk scores highest — near horizons are more actionable.
  horizon String @db.VarChar(16)

  parentGoalId String?
  areaId       String?

  targetDate DateTime?

  /// active | achieved | dropped
  status String @default("active") @db.VarChar(16)

  lastActivityAt DateTime?

  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev         Int     @default(0)
  indexedHash String?

  parentGoal ResparkableGoal?  @relation("ResparkableGoalTree", fields: [parentGoalId], references: [id], onDelete: SetNull)
  childGoals ResparkableGoal[] @relation("ResparkableGoalTree")
  area       ResparkableArea?  @relation(fields: [areaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/resparkable-isolation.ts.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  @@unique([spaceId, slug])
  @@index([spaceId, horizon, status])
  @@index([spaceId, archivedAt])
  @@index([spaceId, visibility])
  @@index([parentGoalId])
  @@index([areaId])
  @@map("framework_resparkable_goal")
}

model ResparkableProject {
  id      String @id @default(cuid())
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  name        String
  slug        String
  description String? @db.Text

  /// idea | active | paused | done | abandoned
  status String @default("active") @db.VarChar(16)

  areaId String?

  priorityScore   Float @default(0)
  priorityFactors Json?

  lastActivityAt DateTime?
  closedAt       DateTime?

  /// Hidden from the active list; `projectMomentum` decay pauses while set (§10).
  snoozedUntil DateTime?

  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev         Int     @default(0)
  indexedHash String?

  area       ResparkableArea?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tasks      ResparkableTask[]
  timeBlocks ResparkableTimeBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/resparkable-isolation.ts.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  @@unique([spaceId, slug])
  @@index([spaceId, status])
  @@index([spaceId, archivedAt])
  @@index([spaceId, visibility])
  @@index([spaceId, priorityScore(sort: Desc)])
  @@index([areaId])
  @@map("framework_resparkable_project")
}

/// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
/// TWO Postgres objects on this model are raw SQL in the migration:
///
///   1. `GENERATED ALWAYS AS (to_tsvector('english', title || notes)) STORED`
///      on `searchVector` — Prisma cannot model GENERATED expressions.
///      Probe B4.
///   2. GIN index `idx_framework_resparkable_task_search_vector` over it. Probe B5.
///
/// Tasks are deliberately NOT embedded (§1): titles are short, high-churn and
/// semantically thin, so a tsvector gives better recall for less money. That is
/// why this model has `searchVector` but no `indexedHash`.
model ResparkableTask {
  id      String @id @default(cuid())
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  title String
  notes String? @db.Text

  /// SetNull, not Cascade: deleting a project must never destroy its tasks —
  /// they fall back to the inbox (§1).
  projectId String?

  /// todo | next | doing | waiting | done | dropped. These are also the default
  /// board columns (§12) — a card drag is a PATCH of this one field.
  status String @default("todo") @db.VarChar(16)

  dueAt DateTime?

  /// Doubles as the task snooze. `deferUntil > now` HARD-ZEROES urgency and
  /// short-circuits the score before any boost is applied (§10).
  deferUntil DateTime?

  estimateMinutes Int?

  /// low | medium | high — matched against the time-of-day energy profile.
  energy String? @db.VarChar(16)

  contextTag String? @db.VarChar(32)

  priorityScore Float @default(0)

  /// Records `base`, `manualBoost` and `boostActive` separately so the UI can
  /// say "ranked #1 — pinned by you, expires Friday" (§10).
  priorityFactors Json?

  /// Human veto over the machine's ranking, clamped to [-1, +1] and applied
  /// ADDITIVELY AFTER the weighted sum — that is what makes +1 provably
  /// outrank every unboosted task. NO AGENT MAY WRITE THIS (§10).
  manualBoost Float @default(0)

  /// An expired boost reads as 0 in the pure scorer — never lazily zeroed by a
  /// background job, so behaviour can't depend on whether the nightly run
  /// happened (§10).
  manualBoostExpiresAt DateTime?
  manualBoostReason    String?

  /// Repeated snoozing is a signal, not noise — five snoozes means "drop it",
  /// "it's blocked" or "it's too big". NEVER an input to score.ts (§10).
  snoozeCount   Int       @default(0)
  lastSnoozedAt DateTime?

  completedAt DateTime?

  /// GENERATED ALWAYS AS (...) STORED — managed by migration, populated by
  /// Postgres. See the drift warning above.
  searchVector Unsupported("tsvector")?

  visibility String @default("private") @db.VarChar(16)

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev Int @default(0)

  project    ResparkableProject?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags       ResparkableTaskTag[]
  checklist  ResparkableChecklistItem[]
  boardCards ResparkableBoardCard[]
  timeBlocks ResparkableTimeBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/resparkable-isolation.ts.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  @@index([spaceId, status])
  @@index([spaceId, archivedAt])
  @@index([spaceId, visibility])
  @@index([spaceId, priorityScore(sort: Desc)])
  @@index([spaceId, dueAt])
  @@index([projectId])
  @@map("framework_resparkable_task")
}

/// The capture inbox — the front door of the whole product.
model ResparkableThought {
  id      String @id @default(cuid())
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  content String @db.Text

  /// web | pwa | voice | image | shortcut | email | chat | agent | api
  source String @default("web") @db.VarChar(16)

  /// Provider-side id (Postmark MessageID, Shortcut run id…) for replay dedupe.
  externalId String?

  /// inbox | promoted | dropped
  status String @default("inbox") @db.VarChar(16)

  /// public | private | sensitive. Classified at capture time by a
  /// deterministic heuristic (never an LLM call — see services/sensitivity.ts),
  /// user-correctable after. Governs which background agents' reads and the
  /// description-summariser see this row. Not a restriction on which provider
  /// a chat turn is sent to, and never applied to the GDPR export path.
  sensitivity String @default("private") @db.VarChar(16)

  /// Set when triage promotes this into a task/project/goal, so the thought
  /// keeps its provenance rather than being consumed.
  promotedToType String? @db.VarChar(16)
  promotedToId   String?

  snoozedUntil  DateTime?
  snoozeCount   Int       @default(0)
  lastSnoozedAt DateTime?

  archivedAt     DateTime?
  archivedReason String?   @db.VarChar(32)

  rev         Int     @default(0)
  indexedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// D1: the cascade path. Erasing a user removes the space row, which
  /// removes every row here. Verified by scripts/smoke/resparkable-isolation.ts.
  space ResparkableSpace @relation(fields: [spaceId], references: [spaceId], onDelete: Cascade)

  @@unique([spaceId, externalId])
  @@index([spaceId, status, createdAt])
  @@index([spaceId, archivedAt])
  @@map("framework_resparkable_thought")
}

/// The one polymorphic edge table (D2). No FKs to targets — orphans are swept
/// by `pruneResparkableOrphans(userId)` and by the transactional delete services.
model ResparkableLink {
  id      String @id @default(cuid())
  spaceId String

  /// Who wrote this row (§23.5). Null in every space that existed before groups
  /// did, and redundant with the owner in a personal space; in a group space it
  /// is what makes attribution and the activity feed possible at all.
  ///
  /// ⚠️ PRISMA-SCHEMA DRIFT WARNING ⚠️
  /// The FK to `"user"("id")` ON DELETE **SetNull** is hand-written (Prisma
  /// cannot model it: no relation field may be added to `User`). Probe B11
  /// covers this column on every satellite at once.
  ///
  /// SetNull rather than Cascade is the point: erasing a member removes their
  /// authorship and leaves the group's content, because that content is the
  /// group's. Note the asymmetry with `ResparkableComment.authorUserId`, which
  /// genuinely cascades — authored rows survive an erasure and comment bodies
  /// do not.
  createdByUserId String?

  sourceType String @db.VarChar(16)
  sourceId   String
  targetType String @db.VarChar(16)
  targetId   String

  /// relates_to | blocks | supports | mentions | duplicates
  kind String @default("relates_to") @db.VarChar(24)

  /// Cosine similarity for swept pairs; null for hand-made links.
  strength  Float?
  rationale String? @db.Text

  /// rule | agent | user | vault. 'vault' is dormant until Release 3 and ships
  /// now so the value never needs adding against live data (§15).
  origin String @default("rule") @db.VarChar(16)

  /// suggested | accepted | rejected | proposed.
  ///
  /// A 'rejected' row is a TOMBSTONE, not dead data: the sweep excludes any
  /// pair that already has a link row, so this is the only thing stopping the
  /// same suggestion returning every Sunday forever. Retention keeps rejected
  /// links FOREVER — pruning them silently reintroduces an infinite nag loop
